{
  "name": "stellix-ui-material",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform UI component library by Stellix — Web (Next.js) + React Native",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test": "pnpm --filter @stellix/ui-core test",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report playwright-report",
    "build:libs": "turbo run build --filter='./packages/*'",
    "publish:dry": "pnpm build:libs && pnpm -r --filter='./packages/*' publish --dry-run --no-git-checks",
    "publish:release": "pnpm build:libs && pnpm -r --filter='./packages/*' publish --no-git-checks",
    "version:patch": "pnpm -r --filter='./packages/*' exec -- pnpm version patch --no-git-tag-version",
    "version:minor": "pnpm -r --filter='./packages/*' exec -- pnpm version minor --no-git-tag-version",
    "version:major": "pnpm -r --filter='./packages/*' exec -- pnpm version major --no-git-tag-version"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.0.0",
    "prettier": "^3.4.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}