{
  "name": "@stellix/ui-native",
  "version": "0.1.4",
  "description": "React Native components for Stellix UI Material — NativeWind + Reanimated",
  "license": "MIT",
  "keywords": [
    "react-native",
    "ui-components",
    "stellix",
    "nativewind",
    "expo",
    "mobile",
    "responsive"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --no-dts --external react --external react-native --external react-native-svg --external @react-native-community/slider --external expo-clipboard --external nativewind",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@stellix/ui-core": "workspace:*",
    "@stellix/ui-tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-native": ">=0.74.0",
    "react-native-reanimated": ">=3.0.0",
    "react-native-gesture-handler": ">=2.0.0",
    "react-native-svg": ">=15.0.0",
    "nativewind": ">=4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-native": "^0.76.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  },
  "sideEffects": false
}
